# Copia este archivo a .env y cambia los valores.
# El archivo .env NO se sube a Git.

# Base de datos PostgreSQL
POSTGRES_DB=consultations_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Gemini (clave de Google AI Studio)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-model-name

# Modo del clasificador: keywords o gemini
CLASSIFIER_MODE=keywords
